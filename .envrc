source_up_if_exists

# Default to alim@fenko.nz
export GCGO_CONFIG_DIR="$(pwd)/.gcgo"

# gcgo-as alim|frontdesk  — switch active profile
gcgo-as() {
  case "$1" in
    alim)      export GCGO_CONFIG_DIR="$(pwd)/.gcgo" ;;
    frontdesk) export GCGO_CONFIG_DIR="$(pwd)/.gcgo-frontdesk" ;;
    *)         echo "Usage: gcgo-as alim|frontdesk" ;;
  esac
}
